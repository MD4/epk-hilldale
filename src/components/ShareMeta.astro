---
// What link previews show (Messages, WhatsApp, Slack, Facebook, X…): title, description and the
// 1200 × 630 picture from src/pages/og-image.jpg.ts.
import { getContent, otherLang, type Lang } from '../lib/content';
import { absolute } from '../lib/paths';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Full public address of the page being shared. */
  url: string;
}

const { lang, title, description, url } = Astro.props;
const { t } = getContent(lang);
const other = getContent(otherLang(lang)).t;
const image = absolute('og-image.jpg');
---

<meta property="og:type" content="website" />
<meta property="og:site_name" content="HILLDALE" />
<meta property="og:url" content={url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:locale" content={t.ogLocale} />
<meta property="og:locale:alternate" content={other.ogLocale} />
<meta property="og:image" content={image} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={t.shareImageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={t.shareImageAlt} />
