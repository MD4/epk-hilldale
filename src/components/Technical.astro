---
import type { Content } from '../lib/content';

interface Props {
  c: Content;
}

const { shared: s, t, lang } = Astro.props.c;
const techPdf = lang === 'fr' ? 'hilldale-fiche-technique.pdf' : 'hilldale-tech-rider.pdf';
---

<section id="technical" class="section wrap split">
  <h2 class="display">{t.technical}</h2>
  <div class="body">
    <ul class="summary">
      <li>{t.techSummaryBand}</li>
      <li>{t.techSummaryTrack}</li>
      <li>{t.techSummaryLights}</li>
      {
        s.setLengthMinutes && (
          <li data-field="set-length">
            {t.setLength}: {s.setLengthMinutes} {t.minutes}
          </li>
        )
      }
    </ul>
    <div class="actions">
      <a class="btn" href={`/downloads/${techPdf}`}>{t.techSheet}</a>
      <a class="btn btn--outline" href={`/downloads/hilldale-onesheet-${lang}.pdf`}>{t.oneSheet}</a>
      <a class="btn btn--outline" href="/downloads/hilldale-presskit.zip">{t.pressKitZip}</a>
    </div>
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    gap: 1.5rem;
  }

  .split > * + * {
    margin-top: 0;
  }

  .body {
    display: grid;
    gap: 1.5rem;
  }

  .summary li {
    padding-block: 0.7rem;
    border-bottom: var(--rule) solid var(--ink);
    font-size: 1.1rem;
  }

  .summary li:first-child {
    border-top: var(--rule) solid var(--ink);
  }

  .actions {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }

  @media (max-width: 800px) {
    .split,
    .actions {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
