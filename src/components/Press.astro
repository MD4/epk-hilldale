---
import { formatDate } from '../lib/format';
import type { Content } from '../lib/content';
import { splitShows, todayIso } from '../lib/shows';

interface Props {
  c: Content;
}

const { shared: s, t, lang } = Astro.props.c;
// Split as of the day the site was built. The script below redoes the split
// on the visitor's own date, so the labels stay right between two builds.
const { upcoming, past } = splitShows(s.shows, todayIso());
const shows = [...upcoming, ...past];
const groups = [
  { key: 'upcoming', label: t.showsUpcoming, list: upcoming },
  { key: 'past', label: t.showsPast, list: past },
];
---

{
  (s.press.length > 0 || shows.length > 0) && (
<section id="press" class="section wrap">
  <h2 class="display">{t.press}</h2>
  {s.press.length > 0 && (
  <div class="quotes">
    {
      s.press.map((p) => (
        <figure data-quote>
          <blockquote lang="fr">“{p.quote.fr}”</blockquote>
          {lang === 'en' && p.quote.en && <p class="translation">“{p.quote.en}”</p>}
          <figcaption class="label">
            {p.url ? <a href={p.url}>{p.source}</a> : p.source}, {formatDate(p.date)}
          </figcaption>
        </figure>
      ))
    }
  </div>
  )}

  {
    shows.length > 0 && (
      <div data-shows>
        <h3 class="display">{t.shows}</h3>
        {groups.map((group) => (
          <div class="group" data-shows-group={group.key} hidden={group.list.length === 0}>
            <h4 class="label">{group.label}</h4>
            <ul class="shows">
              {group.list.map((show) => (
                <li data-date={show.date}>
                  <span class="date">{formatDate(show.date)}</span>
                  <span class="strong">{show.city}</span>
                  {show.venue && <span>{show.venue}</span>}
                  {show.with && <span>{t.showsWith} {show.with}</span>}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    )
  }
</section>
  )
}

<script is:inline>
  // Sort the shows into "upcoming" and "past" using today's date on the visitor's device.
  document.querySelectorAll('[data-shows]').forEach((root) => {
    const now = new Date();
    const pad = (n) => String(n).padStart(2, '0');
    const today = now.getFullYear() + '-' + pad(now.getMonth() + 1) + '-' + pad(now.getDate());
    const items = [...root.querySelectorAll('li[data-date]')];
    const byDate = (a, b) => a.dataset.date.localeCompare(b.dataset.date);
    const lists = {
      upcoming: items.filter((li) => li.dataset.date >= today).sort(byDate),
      past: items.filter((li) => li.dataset.date < today).sort(byDate).reverse(),
    };
    for (const [key, list] of Object.entries(lists)) {
      const group = root.querySelector('[data-shows-group="' + key + '"]');
      group.querySelector('ul').replaceChildren(...list);
      group.hidden = list.length === 0;
    }
  });
</script>

<style>
  [data-shows] {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }

  .group {
    display: grid;
    gap: 0.5rem;
  }

  .quotes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  figure {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.25rem;
    border: var(--rule) solid var(--ink);
  }

  blockquote {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    line-height: 1.05;
    text-transform: uppercase;
    text-wrap: balance;
  }

  figcaption {
    margin-top: auto;
  }

  .shows {
    border-top: var(--rule) solid var(--ink);
  }

  .shows li {
    display: grid;
    grid-template-columns: 7rem repeat(3, minmax(0, 1fr));
    gap: 0.25rem 1rem;
    align-items: baseline;
    padding-block: 0.7rem;
    border-bottom: var(--rule) solid var(--ink);
  }

  .date {
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 800px) {
    .quotes {
      grid-template-columns: minmax(0, 1fr);
    }

    .shows li {
      grid-template-columns: 6rem minmax(0, 1fr);
    }

    .shows li span:nth-child(n + 3) {
      grid-column: 2;
    }
  }
</style>
