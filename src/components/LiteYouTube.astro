---
import { Image } from 'astro:assets';
import { photo } from '../lib/assets';

interface Props {
  id: string;
  title: string;
  photoFile: string;
  /** The featured clip plays in place; the others open YouTube. */
  embed?: boolean;
  label: string;
}

const { id, title, photoFile, embed = false, label } = Astro.props;
---

<a
  class:list={['clip', { 'clip--featured': embed }]}
  href={`https://www.youtube.com/watch?v=${id}`}
  data-yt-embed={embed ? id : undefined}
  data-yt-title={title}
>
  <span class="frame">
    <Image src={photo(photoFile)} alt="" widths={[480, 960]} sizes={embed ? '(min-width: 800px) 66vw, 100vw' : '(min-width: 800px) 33vw, 50vw'} />
  </span>
  <span class="bar">
    <span>{title}</span>
    <span class="hint">
      <span class="label">{label}</span>
      <svg aria-hidden="true" width="14" height="16" viewBox="0 0 14 16"><path d="M0 0l14 8-14 8z" fill="currentColor"></path></svg>
    </span>
  </span>
</a>

<style>
  .clip {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border: var(--rule) solid var(--ink);
    text-decoration: none;
  }

  .frame {
    position: relative;
    display: block;
    flex: 1;
    min-height: 0;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--ink);
  }

  .frame :global(img),
  .frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
    border: 0;
  }

  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.85rem;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.3rem, 2.2vw, 1.75rem);
    line-height: 1.1;
    text-transform: uppercase;
  }

  .hint {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .clip:not(.clip--featured) .label {
    display: none;
  }

  .clip:hover {
    color: inherit;
  }

  .clip:hover .frame :global(img) {
    filter: contrast(1.15);
  }
</style>
