---
import LiteYouTube from './LiteYouTube.astro';
import type { Content } from '../lib/content';

interface Props {
  c: Content;
}

const { c } = Astro.props;
const { shared: s, t } = c;
const featured = s.videos.find((v) => v.featured)!;
const others = s.videos.filter((v) => !v.featured);
---

<section id="listen" class="section wrap">
  <div class="head">
    <h2 class="display">{t.listenWatch}</h2>
    <ul class="platforms label">
      <li><a href={s.links.bandcamp}>Bandcamp</a></li>
      <li><a href={s.links.spotify}>Spotify</a></li>
      <li><a href={s.links.deezer}>Deezer</a></li>
    </ul>
  </div>

  <div class="clips">
    <LiteYouTube id={featured.id} title={featured.title} photoFile={featured.photo} label={t.officialVideo} embed />
    {others.map((v) => <LiteYouTube id={v.id} title={v.title} photoFile={v.photo} label={t.officialVideo} />)}
  </div>

  {
    s.ep.bandcampAlbumId && (
      <div class="player">
        <button
          type="button"
          class="btn btn--outline"
          data-bandcamp={`https://bandcamp.com/EmbeddedPlayer/album=${s.ep.bandcampAlbumId}/size=large/bgcol=ffffff/linkcol=000000/tracklist=false/artwork=small/transparent=true/`}
          data-title={`${s.ep.title} (Bandcamp)`}
          hidden
        >
          {t.playEp}
        </button>
      </div>
    )
  }
</section>

<script is:inline>
  // Swap the featured clip's photo for the YouTube player only when the visitor asks for it.
  document.querySelectorAll('a[data-yt-embed]').forEach((link) => {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      const player = document.createElement('iframe');
      player.src = 'https://www.youtube-nocookie.com/embed/' + link.dataset.ytEmbed + '?autoplay=1&rel=0';
      player.title = link.dataset.ytTitle;
      player.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      player.allowFullscreen = true;
      link.querySelector('.frame').replaceChildren(player);
    }, { once: true });
  });

  // Same for the Bandcamp player: nothing from Bandcamp loads until the visitor asks.
  document.querySelectorAll('button[data-bandcamp]').forEach((button) => {
    button.hidden = false;
    button.addEventListener('click', () => {
      const player = document.createElement('iframe');
      player.src = button.dataset.bandcamp;
      player.title = button.dataset.title;
      player.className = 'bandcamp';
      button.replaceWith(player);
    });
  });
</script>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 2rem;
  }

  .platforms {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    font-size: 1.1rem;
  }

  .platforms a {
    display: inline-block;
    padding-block: 0.6rem;
  }

  .clips {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .clips :global(.clip--featured) {
    grid-column: span 2;
    grid-row: span 2;
  }

  .player :global(.bandcamp) {
    display: block;
    width: 100%;
    height: 120px;
    border: var(--rule) solid var(--ink);
  }

  @media (max-width: 800px) {
    .clips {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }

    .clips :global(.clip--featured) {
      grid-row: auto;
    }
  }
</style>
