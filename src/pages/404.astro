---
import '@fontsource/big-shoulders-display/800';
import '@fontsource/archivo/400';
import '../styles/global.css';
import Favicons from '../components/Favicons.astro';
import { href } from '../lib/paths';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>HILLDALE · 404</title>
    <meta name="robots" content="noindex" />
    <Favicons />
  </head>
  <body>
    <main class="wrap">
      <h1 class="display">Nothing here</h1>
      <p lang="fr">Cette page n’existe pas. <a href={href('fr/')}>Dossier de presse (français)</a></p>
      <p>This page does not exist. <a href={href('en/')}>Press kit (English)</a></p>
    </main>
  </body>
</html>

<style>
  main {
    display: grid;
    gap: 1rem;
    padding-block: 4rem;
  }
</style>
