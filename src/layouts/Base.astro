---
import '@fontsource/big-shoulders-display/600';
import '@fontsource/big-shoulders-display/800';
import '@fontsource/archivo/400';
import '@fontsource/archivo/600';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { photo } from '../lib/assets';
import { LANGS, getContent, type Lang } from '../lib/content';
import { absolute, href } from '../lib/paths';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path after the language segment, e.g. '' for the EPK page or 'tech/'. */
  path?: string;
}

const { lang, title, description, path = '' } = Astro.props;
const { shared, t } = getContent(lang);
const { SITE } = shared;
// The picture shown when the link is pasted into a chat or a social post.
const preview = await getImage({ src: photo(shared.heroPhoto), width: 1200, format: 'jpeg', quality: 80 });
const urlFor = (l: Lang) => absolute(`${l}/${path}`);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!SITE.indexable && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={urlFor(lang)} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={urlFor(l)} />)}
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(preview.src, Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">{t.skipLink}</a>
    <slot />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -100vw;
    z-index: 20;
    padding: 0.75rem 1rem;
    background: var(--paper);
    color: var(--ink);
  }

  .skip:focus {
    left: 0;
    top: 0;
  }
</style>
